<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Speiler Prosjekt-planlegger-data til Obsidian-vaulten hvert kvarter.
       Installeres med:
       cp no.eiriksorbo.prosjekt-planlegger-synk.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/no.eiriksorbo.prosjekt-planlegger-synk.plist
       Stien under peker på repomappa prosjekt-planlegger.
       Uten tools/nokkel.json avslutter skriptet stille, så jobben er ufarlig
       før oppsettet er fullført. -->
  <key>Label</key>
  <string>no.eiriksorbo.prosjekt-planlegger-synk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/eiriks05/Documents/Eiriks Script/prosjekt-planlegger/tools/vault-synk.mjs</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/eiriks05/Library/Logs/prosjekt-planlegger-synk.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/eiriks05/Library/Logs/prosjekt-planlegger-synk.log</string>
</dict>
</plist>
