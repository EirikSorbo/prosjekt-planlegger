<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Speiler Prosjekt-planlegger-data til Obsidian-vaulten hvert kvarter.
       VIKTIG: jobben kjører en KOPI av skript + nøkkel fra
       ~/Library/Application Support/prosjekt-planlegger-synk/ — ikke fra
       repoet. Grunn: ~/Documents er TCC-beskyttet i macOS, og launchd-jobber
       nektes å lese der (EPERM). Installering/oppdatering (kopierer filene og
       (re)starter jobben) står i SETUP-CLAUDE.md under «Installer/oppdater
       autosynken». -->
  <key>Label</key>
  <string>no.eiriksorbo.prosjekt-planlegger-synk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/eiriks05/Library/Application Support/prosjekt-planlegger-synk/vault-synk.mjs</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/eiriks05/Library/Logs/prosjekt-planlegger-synk.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/eiriks05/Library/Logs/prosjekt-planlegger-synk.log</string>
</dict>
</plist>
